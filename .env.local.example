# Copy this file to .env.local and fill in real values.
# .env.local is already gitignored - never commit real secrets.

# Postgres connection string (Supabase, Neon, or any Postgres host).
# Include ?sslmode=require if your host needs SSL (Supabase/Neon both do).
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# From your Discord application at https://discord.com/developers/applications
# OAuth2 > Redirect URI must include: <your-app-url>/api/auth/callback/discord
# (e.g. http://localhost:3210/api/auth/callback/discord for local dev)
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Random secret used to sign session tokens. Generate one with:
#   npx auth secret
# or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Comma-separated Discord IDs (the numeric snowflake, not the
# username) allowed into /admin to moderate guilds - rename or delete
# any guild regardless of ownership. Find a user's ID with
# `SELECT discord_id FROM users WHERE username = '...'`.
ADMIN_DISCORD_IDS=

# Random secret for the daily DKP-decay job (/api/cron/decay). Vercel sends it
# as a Bearer token; set the same value in the Vercel project. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=****
